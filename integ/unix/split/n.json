{
  "cases": [
    {
      "id": "split_n_spreads_the_byte_remainder_first",
      "seq": 991029,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "mkdir -p /data/spb && cd /data/spb && printf abcdefg > g && split -n 3 g p && cat paa && printf '|' && cat pab && printf '|' && cat pac",
      "expect": {
        "exit": 0,
        "stdout": "abc|de|fg",
        "stderr": ""
      },
      "flags": [
        "n"
      ]
    },
    {
      "id": "split_n_creates_every_chunk_file",
      "seq": 991030,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "mkdir -p /data/spe && cd /data/spe && printf ab > h && split -n 5 h p && ls p* | tr '\\n' ' ' && cat pac | wc -c",
      "expect": {
        "exit": 0,
        "stdout": "paa pab pac pad pae 0\n",
        "stderr": ""
      },
      "flags": [
        "n"
      ]
    },
