{
  "cases": [
    {
      "id": "numfmt_unrecognized_option_keeps_the_value_raw",
      "seq": 991037,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "numfmt --zzz='é'",
      "expect": {
        "exit": 1,
        "stdout": "",
        "stderr": "numfmt: unrecognized option '--zzz=é'\nTry 'numfmt --help' for more information.\n"
      }
    },
    {
      "id": "numfmt_operand_diagnostic_octal_escapes_the_same_bytes",
      "seq": 991038,
      "targets": [
        "ram",
        "disk"
      ],
      "command": "numfmt -- '--zzz=é'",
      "expect": {
        "exit": 2,
        "stdout": "",
        "stderr": "numfmt: invalid number: '--zzz=\\303\\251'\n"
      }
    }
  ]
}
