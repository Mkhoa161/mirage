{
  "command": "wc",
  "cases": [
    {
      "id": "wc_default",
      "cmd": "wc /data/a.txt",
      "matrix": {
        "python": [
          "ram",
          "disk",
          "redis"
        ],
        "typescript": [
          "ram",
          "disk",
          "redis"
        ]
      },
      "expect": {
        "exit": 0,
        "stdout_text": " 5  5 24 /data/a.txt\n",
        "stderr_text": ""
      }
    },
    {
      "id": "wc_lines",
      "cmd": "wc -l /data/a.txt",
      "matrix": {
        "python": [
          "ram",
          "disk",
          "redis"
        ],
        "typescript": [
          "ram",
          "disk",
          "redis"
        ]
      },
      "expect": {
        "exit": 0,
        "stdout_text": "5 /data/a.txt\n",
        "stderr_text": ""
      }
    },
    {
      "id": "wc_words",
