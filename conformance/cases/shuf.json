{
  "command": "shuf",
  "cases": [
    {
      "id": "shuf_n_invalid_word",
      "cmd": "shuf -n abc",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 1,
        "stdout_text": "",
        "stderr_text": "shuf: invalid line count: 'abc'\n"
      }
    },
    {
      "id": "shuf_n_trailing_garbage_quotes_whole_arg",
      "cmd": "shuf -n 2x",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 1,
        "stdout_text": "",
        "stderr_text": "shuf: invalid line count: '2x'\n"
      }
    },
    {
      "id": "shuf_n_valid_one",
      "cmd": "shuf -n 1",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 0,
        "stdout_text": "x\n",
        "stderr_text": ""
      }
    },
    {
      "id": "shuf_n_minus_is_an_invalid_character",
      "cmd": "shuf -n -1",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 1,
        "stdout_text": "",
        "stderr_text": "shuf: invalid line count: '-1'\n"
      }
    },
    {
      "id": "shuf_n_zero_prints_nothing",
      "cmd": "shuf -n 0",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 0,
        "stdout_text": "",
        "stderr_text": ""
      }
    },
    {
      "id": "shuf_n_empty_is_refused",
      "cmd": "shuf -n ''",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 1,
        "stdout_text": "",
        "stderr_text": "shuf: invalid line count: ''\n"
      }
    },
    {
      "id": "shuf_i_nonnumeric_high_bound",
      "cmd": "shuf -i 1-x",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 1,
        "stdout_text": "",
        "stderr_text": "shuf: invalid input range: '1-x'\n"
      }
    },
    {
      "id": "shuf_i_nonnumeric_low_bound",
      "cmd": "shuf -i x-3",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 1,
        "stdout_text": "",
        "stderr_text": "shuf: invalid input range: 'x-3'\n"
      }
    },
    {
      "id": "shuf_i_decreasing_range_has_no_diagnostic_of_its_own",
      "cmd": "shuf -i 3-1",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 1,
        "stdout_text": "",
        "stderr_text": "shuf: invalid input range: '3-1'\n"
      }
    },
    {
      "id": "shuf_i_negative_low_bound",
      "cmd": "shuf -i -2-1",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 1,
        "stdout_text": "",
        "stderr_text": "shuf: invalid input range: '-2-1'\n"
      }
    },
    {
      "id": "shuf_i_missing_dash",
      "cmd": "shuf -i 1",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 1,
        "stdout_text": "",
        "stderr_text": "shuf: invalid input range: '1'\n"
      }
    },
    {
      "id": "shuf_i_empty_is_refused",
      "cmd": "shuf -i ''",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 1,
        "stdout_text": "",
        "stderr_text": "shuf: invalid input range: ''\n"
      }
    },
    {
      "id": "shuf_i_single_element_range_is_valid",
      "cmd": "shuf -i 2-2",
      "matrix": {
        "python": ["ram", "disk", "redis"],
        "typescript": ["ram", "disk", "redis"]
      },
      "stdin_text": "x\n",
      "expect": {
        "exit": 0,
        "stdout_text": "2\n",
        "stderr_text": ""
      }
    }
  ]
}
